# findaro website, API and the old demo hostname. Rendered by deploy.sh into /srv/caddy/sites/findaro.caddy.
(findaro_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

__SITE_HOST__ {
	import findaro_headers
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	header X-Frame-Options DENY
	reverse_proxy findaro-site:8080
}

__API_HOST__ {
	import findaro_headers
	@compress not path /v1/chat
	encode @compress zstd gzip
	request_body {
		max_size 60MB
	}
	reverse_proxy findaro-api:8000 {
		flush_interval -1
	}
}

__OLD_HOSTS__ {
	redir https://__SITE_HOST__{uri} 308
}
