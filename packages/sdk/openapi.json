    "title": "Body_import_file_v1_projects__project_id__import_post"
   },
   "ChatRequest": {
    "properties": {
     "session_id": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 64
       },
       {
        "type": "null"
       }
      ],
      "title": "Session Id"
     },
     "message": {
      "type": "string",
      "maxLength": 500,
      "title": "Message",
      "default": ""
     },
     "apply": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Apply"
     },
     "patch": {
      "anyOf": [
       {
        "items": {
         "$ref": "#/components/schemas/PatchOp"
        },
        "type": "array",
        "maxItems": 20
       },
       {
        "type": "null"
       }
      ],
      "title": "Patch"
     },
     "product_ids": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array",
        "maxItems": 3
       },
       {
        "type": "null"
       }
      ],
      "title": "Product Ids"
     },
     "size": {
      "type": "integer",
      "maximum": 50.0,
      "minimum": 1.0,
      "title": "Size",
      "default": 10
     }
    },
    "type": "object",
    "title": "ChatRequest"
   },
   "Chip": {
    "properties": {
     "label": {
      "type": "string",
      "title": "Label"
     },
     "kind": {
      "type": "string",
      "enum": [
       "filter",
       "boost",
       "sort"
      ],
      "title": "Kind"
     },
     "field": {
      "type": "string",
      "title": "Field"
     },
     "op": {
      "type": "string",
      "title": "Op"
     },
     "value": {
      "title": "Value"
     },
     "source": {
      "type": "string",
      "title": "Source"
     },
     "confidence": {
      "type": "number",
      "title": "Confidence"
     },
     "remove": {
      "items": {
       "$ref": "#/components/schemas/PatchOp"
      },
      "type": "array",
      "title": "Remove"
     }
    },
    "type": "object",
    "required": [
     "label",
     "kind",
     "field",
     "op",
     "source",
     "confidence"
    ],
    "title": "Chip",
    "description": "One thing the engine understood, ready to show (and let the user remove) in a search UI."
   },
