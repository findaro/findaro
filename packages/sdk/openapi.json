  "/v1/chat": {
   "post": {
    "summary": "Chat",
    "description": "Conversational search over Server-Sent Events: session, plan, results, clarify?, text*, done.",
    "operationId": "chat_v1_chat_post",
    "requestBody": {
     "content": {
      "application/json": {
