{
  "name": "@zerch/sdk",
  "version": "0.1.0",
  "description": "Headless TypeScript client for zerch AI search (search + streaming chat). Zero dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/zerch-sdk.umd.js",
  "module": "./dist/zerch-sdk.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/zerch-sdk.mjs",
      "require": "./dist/zerch-sdk.umd.js"
    }
  },
  "unpkg": "./dist/zerch-sdk.umd.js",
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs && tsc -p . --emitDeclarationOnly"
  }
}
