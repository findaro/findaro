{
  "name": "@findaro/widget",
  "version": "0.1.0",
  "description": "Drop-in <findaro-search> Web Component: AI search box, chips, facet pills, results grid and AI chat panel.",
  "license": "Apache-2.0",
  "author": "The findaro authors",
  "keywords": [
    "findaro",
    "search",
    "ai-search",
    "web-component",
    "widget",
    "search-ui",
    "hinglish"
  ],
  "type": "module",
  "main": "./dist/findaro-widget.js",
  "module": "./dist/findaro-widget.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/findaro-widget.mjs",
      "default": "./dist/findaro-widget.js"
    }
  },
  "unpkg": "./dist/findaro-widget.js",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "node build.mjs && tsc -p . --emitDeclarationOnly"
  },
  "dependencies": {
    "@findaro/sdk": "0.1.0"
  }
}
